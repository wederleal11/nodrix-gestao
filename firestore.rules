rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Fixed owner allowlist; checked against verified Google auth token, never a profile field.
    function isInitialAdmin() {
      return isVerified() &&
        request.auth.token.firebase.sign_in_provider == 'google.com' &&
        request.auth.token.email in ['wederleal11@gmail.com', 'weder.leal@nodrix.com.br'];
    }

    function isAdmin() {
      return isVerified() && (
        isInitialAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active')
      );
    }

    function isUserSelf(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isActiveMember() {
      return isVerified() && (
        isInitialAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active')
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isActiveMember() || isUserSelf(userId);

      allow create: if isVerified() && (
        // New users cannot approve themselves or become admins.
        (isUserSelf(userId) &&
         ((incoming().role == 'collaborator' && incoming().status == 'pending') || isInitialAdmin())) ||
        isAdmin()
      );

      allow update: if isVerified() && (
        isAdmin() ||
        (isActiveMember() && isUserSelf(userId) &&
         // Immutable identity, role and status on self-service updates.
         !incoming().diff(existing()).affectedKeys().hasAny(['uid', 'role', 'status', 'isSuperAdmin', 'email'])
        )
      );

      allow delete: if isAdmin() && !isUserSelf(userId);
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if isActiveMember();
      
      allow create: if isAdmin() && isValidId(projectId) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 120;
        
      allow update: if isActiveMember() && (
        isAdmin() ||
        // Assigned members can update status
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
         existing().memberIds is list && existing().memberIds.hasAny([request.auth.uid]))
      );

      allow delete: if isAdmin();
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isActiveMember();

      allow create: if isActiveMember() && isValidId(taskId) &&
        incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 200 &&
        incoming().projectId is string && incoming().projectId.size() <= 128 &&
        incoming().assigneeId is string && incoming().assigneeId.size() > 0 &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.assigneeId)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.assigneeId)).data.status == 'active';

      allow update: if isActiveMember() && (
        isAdmin() ||
        // Collaborator updating their assigned task: cannot skip validation to completed directly
        // nor approve their own delivery if not admin
        (
          // Cannot approve own delivery without admin rights
          !(incoming().status == 'completed' && existing().status != 'completed' && existing().assigneeId == request.auth.uid && !isAdmin())
        )
      );

      allow delete: if isAdmin();
    }

    // Audit logs (Immutable)
    match /audit_logs/{logId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && isValidId(logId) &&
        incoming().action is string && incoming().actorId is string;
      allow update, delete: if false; // Append-only
    }

    // Weekly events
    match /weekly_events/{eventId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isValidId(eventId) &&
        incoming().title is string && incoming().title.size() <= 150;
      allow delete: if isActiveMember();
    }

    // Daily check-ins
    match /daily_checkins/{checkinId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isValidId(checkinId) &&
        (incoming().userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Feedbacks (Confidential RBAC - Strictly Admin Only)
    match /feedbacks/{feedbackId} {
      // Only Manager/Admin can read, create, update, or delete feedback
      allow read, create, update, delete: if isVerified() && isAdmin();
    }

    // Priority change requests
    match /priority_requests/{requestId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && isValidId(requestId) &&
        incoming().requesterId == request.auth.uid;
      allow update: if isAdmin(); // Only manager can approve/reject
      allow delete: if isAdmin();
    }

    // System settings
    match /system_settings/{settingId} {
      allow read: if isActiveMember();
      allow write: if isActiveMember();
    }
  }
}
